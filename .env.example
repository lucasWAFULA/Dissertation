# ─────────────────────────────────────────────────────────────────
# Market Price Pulse AI — Environment Variables Template
# Copy to .env and fill in your values before running locally or deploying.
# NEVER commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── FastAPI / Inference Service ──────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Maximum rows per /v1/score or /v1/score/csv request
API_MAX_SCORE_ROWS=50000

# CORS: comma-separated allowed origins for the React frontend
# Use "*" for development, explicit origin in production
CORS_ORIGINS=http://localhost:3000

# ── Ensemble Configuration ───────────────────────────────────────
# Weight for Logistic Regression (0–1); XGBoost gets 1 - this value
# Default: LR=0.6 (best model, F1=0.841), XGB=0.4
ENSEMBLE_LR_WEIGHT=0.6

# Ensemble strategy: "weighted" | "soft_vote" | "hard_vote"
ENSEMBLE_STRATEGY=weighted

# Optional: override artifact paths (defaults use outputs/ directory)
# LR_MODEL_PATH=outputs/best_model.joblib
# XGB_MODEL_PATH=outputs/model_xgb_anomaly.joblib

# ── Node.js Frontend ─────────────────────────────────────────────
PORT=3000

# FastAPI base URL (Express proxy target)
# Development: http://localhost:8000
# Kubernetes (in-cluster): http://inference-svc:8000
API_BASE_URL=http://localhost:8000

# ── WFP VAM API (Live Data Ingest) ──────────────────────────────
# Get your key from: https://api.vam.wfp.org
WFP_API_KEY=your_wfp_api_key_here

# ── Database ─────────────────────────────────────────────────────
# SQLite (local/Cloud Run):
# DATABASE_URL is auto-set from config.py using the project root path

# PostgreSQL (production — replace SQLite for K8s):
# DATABASE_URL=postgresql://user:password@host:5432/market_pulse

# ── Google Cloud (Kubernetes Deployment) ─────────────────────────
# GCP Project ID (used by deploy-gcloud.ps1 and CI/CD pipeline)
GCP_PROJECT_ID=your-gcp-project-id

# GKE cluster name and region
GKE_CLUSTER=market-pulse-cluster
GKE_REGION=us-central1

# ── Streamlit (Legacy — keep if Streamlit is still running) ──────
# STREAMLIT_SCORING_API_URL=http://localhost:8000
