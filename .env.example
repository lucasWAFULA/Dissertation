# Data Configuration
FPMA_DATA_PATH=FPMA_international_price_data.csv
WFP_DATA_PATH=wfp_food_prices_ken (1).csv
INFLATION_DATA_PATH=Inflation Rates.csv

# Logging
LOG_LEVEL=INFO
